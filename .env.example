# Khoa API: OpenCode (oc_sk_...) hoac OpenAI
OPENAI_API_KEY=your_api_key_here

# Endpoint: OpenCode Zen API (de trong neu dung OpenAI mac dinh)
OPENAI_BASE_URL=https://opencode.ai/zen/v1

# Mo hinh AI: space-bunny-free (OpenCode) hoac gpt-4o-mini (OpenAI)
OPENAI_MODEL=space-bunny-free
OPENAI_TEMPERATURE=0.3
OPENAI_TIMEOUT=30

# Cau hinh may chu
HOST=127.0.0.1
PORT=2904

# Bo nho luu tru hoi thoai va system prompt
MEMORY_FILE=memory.json
MAX_MESSAGES=5
SYSTEM_PROMPT_FILE=system-prompt.txt
